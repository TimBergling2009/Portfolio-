:root{
  --bg0:#070b18;
  --bg1:#0b1030;
  --panel:rgba(255,255,255,.07);
  --panel2:rgba(255,255,255,.05);
  --line:rgba(255,255,255,.14);
  --text:rgba(255,255,255,.92);
  --muted:rgba(255,255,255,.72);
  --muted2:rgba(255,255,255,.58);

  --a:#7c5cff;     /* 紫 */
  --b:#2ee9a7;     /* 青 */
  --c:#5bd1ff;     /* 蓝 */

  --radius:22px;
  --shadow: 0 18px 60px rgba(0,0,0,.55);
  --max: 1120px;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  color:var(--text);
  font-family: ui-sans-serif, system-ui, -apple-system, "PingFang SC","Microsoft YaHei", Arial, sans-serif;
  background:
    radial-gradient(1200px 700px at 20% 10%, rgba(124,92,255,.18), transparent 55%),
    radial-gradient(900px 600px at 85% 20%, rgba(46,233,167,.14), transparent 55%),
    radial-gradient(900px 700px at 70% 85%, rgba(91,209,255,.10), transparent 60%),
    linear-gradient(180deg, var(--bg1), var(--bg0));
}

.bg-glow{
  position:fixed; inset:-40%;
  background:
    radial-gradient(closest-side at 30% 30%, rgba(124,92,255,.18), transparent 60%),
    radial-gradient(closest-side at 70% 30%, rgba(46,233,167,.14), transparent 60%),
    radial-gradient(closest-side at 60% 70%, rgba(91,209,255,.12), transparent 65%);
  filter: blur(40px);
  pointer-events:none;
  opacity:.85;
}

.wrap{
  width:min(var(--max), calc(100% - 48px));
  margin:40px auto 56px;
  position:relative;
}

.card{
  background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.05));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  backdrop-filter: blur(10px);
}

.hero{
  display:grid;
  grid-template-columns: 1.1fr .9fr;
  gap:18px;
  align-items:start;
  margin-bottom:26px;
}

.hero-left{padding:22px}
.hero-right{display:flex; flex-direction:column; gap:14px}

.pill{
  display:inline-flex; align-items:center; gap:10px;
  padding:8px 12px;
  border:1px solid var(--line);
  border-radius: 999px;
  background: rgba(255,255,255,.05);
  font-size:13px;
  color:var(--muted);
}
.dot{
  width:8px;height:8px;border-radius:999px;
  background: radial-gradient(circle at 30% 30%, #fff, var(--b));
  box-shadow: 0 0 18px rgba(46,233,167,.55);
}

.title{
  margin:14px 0 10px;
  font-size:44px;
  line-height:1.05;
  letter-spacing:.2px;
}
@media (max-width: 980px){
  .hero{grid-template-columns:1fr}
  .title{font-size:40px}
}

.lead{
  margin:0;
  color:var(--muted);
  font-size:16.5px;
  line-height:1.7;
}

.accent{
  background: linear-gradient(90deg, var(--a), var(--c));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  font-weight:800;
}

.key{
  display:inline-block;
  padding:0 8px;
  border-radius:10px;
  background: rgba(124,92,255,.16);
  border:1px solid rgba(124,92,255,.35);
  color:#d7d0ff;
  font-weight:700;
}

.stats{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:12px;
  margin:18px 0 16px;
}
@media (max-width: 820px){
  .stats{grid-template-columns:1fr}
}
.stat{padding:14px}
.stat .k{font-size:12px; color:var(--muted2); letter-spacing:.4px}
.stat .v{margin-top:6px; font-weight:700; font-size:14.5px}

.quote{
  display:flex; gap:12px;
  padding:14px 16px;
  background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.04));
}
.qmark{
  font-size:34px;
  line-height:1;
  color: rgba(255,255,255,.35);
}
.qmain{margin:0; font-weight:800}
.qsub{margin:6px 0 0; color:var(--muted); line-height:1.6; font-size:14px}

.figure{padding:12px}
.figure img{
  width:100%;
  border-radius: 18px;
  display:block;
  border:1px solid rgba(255,255,255,.12);
}
.figure figcaption{
  margin-top:10px;
  color:var(--muted);
  font-size:13.5px;
  line-height:1.5;
}

.chips{display:flex; flex-wrap:wrap; gap:8px}
.chip{
  font-size:12px;
  padding:7px 10px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.04);
  color:rgba(255,255,255,.78);
}

.section{
  margin-top:20px;
  padding:18px;
  border-radius: var(--radius);
  border:1px solid rgba(255,255,255,.10);
  background: rgba(0,0,0,.08);
}
.section.alt{
  background: rgba(0,0,0,.06);
}
.section-head{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:16px;
  margin-bottom:12px;
}
.section-head h2{
  margin:0;
  font-size:22px;
  letter-spacing:.2px;
}
.muted{color:var(--muted)}
.small{font-size:13px}

.grid2{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:14px;
}
.grid2.reverse{
  grid-template-columns: 1fr 1fr;
}
@media (max-width: 920px){
  .grid2, .grid2.reverse{grid-template-columns:1fr}
}

.grid3{
  display:grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap:14px;
}
@media (max-width: 980px){
  .grid3{grid-template-columns:1fr}
}

.text{padding:16px}
.text h3{
  margin:0 0 10px;
  font-size:18px;
}
.text p{
  margin:0 0 10px;
  line-height:1.75;
  color:var(--muted);
  font-size:15.5px;
}
.text p:last-child{margin-bottom:0}

.mini{
  margin-top:12px;
  padding:12px;
  border-radius:16px;
  border:1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.04);
}
.mini-k{font-size:12px; color:var(--muted2); letter-spacing:.4px}
.mini-v{margin-top:6px; font-weight:750}

.media{padding:12px}
.media img{
  width:100%;
  display:block;
  border-radius:18px;
  border:1px solid rgba(255,255,255,.12);
  max-height: 420px;
  object-fit: cover;
}
.media figcaption{
  margin-top:10px;
  color:var(--muted);
  font-size:13.5px;
  line-height:1.5;
}

.gallery .masonry{
  display:grid;
  grid-template-columns: 1.1fr .9fr 1fr;
  gap:14px;
}
@media (max-width: 980px){
  .gallery .masonry{grid-template-columns:1fr}
}
.tile{padding:12px}
.tile img{
  width:100%;
  display:block;
  border-radius:18px;
  border:1px solid rgba(255,255,255,.12);
  object-fit: cover;
}
.tile figcaption{
  margin-top:10px;
  color:var(--muted);
  font-size:13px;
  line-height:1.45;
}

.footer{
  margin-top:22px;
  padding:14px 4px 0;
}
.line{
  height:1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
  margin-bottom:10px;
}
.foot{
  margin:0;
  color: rgba(255,255,255,.55);
  font-size:12.5px;
}